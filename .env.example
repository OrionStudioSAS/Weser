# En production derrière un reverse proxy : origine HTTPS exacte, sans / final.
APP_ORIGIN=
# HOST=0.0.0.0 si requis par votre hébergement.
GITHUB_TOKEN=
GITHUB_OWNER=OrionStudioSAS
GITHUB_REPO=Weser
GITHUB_BRANCH=main
GITHUB_DATA_PATH=data/veille.json
# Dépôt privé obligatoire pour la sauvegarde.
# Protection HTTP Basic obligatoire en production, également active en dev si renseignée.
ADMIN_USER=weser
ADMIN_PASSWORD=
